{
  "__inputs": [
    {
      "name": "DS_POSTGRESQL",
      "label": "PostgreSQL",
      "description": "PostgreSQL datasource for campaign_data database",
      "type": "datasource",
      "pluginId": "grafana-postgresql-datasource",
      "pluginName": "PostgreSQL"
    }
  ],
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "10.0.0"
    },
    {
      "type": "datasource",
      "id": "grafana-postgresql-datasource",
      "name": "PostgreSQL",
      "version": "1.0.0"
    }
  ],
  "id": null,
  "uid": null,
  "title": "check-my-ads-inst490",
  "description": "INST490 dashboard for comparing Google Ads CSV snapshots over time",
  "tags": [
    "google-ads",
    "anomaly-detection",
    "snapshot-changes"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "2025-08-01T00:00:00.000Z",
    "to": "2025-09-30T23:59:59.000Z"
  },
  "timepicker": {},
  "templating": {
    "list": [
      {
        "name": "placement_type",
        "label": "Placement Type",
        "type": "query",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "${DS_POSTGRESQL}"
        },
        "query": "SELECT DISTINCT placement_type AS __text, placement_type AS __value FROM google_ads_placements WHERE placement_type IS NOT NULL ORDER BY placement_type",
        "multi": true,
        "includeAll": true,
        "current": {
          "selected": true,
          "text": ["All"],
          "value": ["$__all"]
        },
        "refresh": 1
      },
      {
        "name": "min_drop",
        "label": "Min Drop Amount",
        "type": "custom",
        "query": "0,1,5,10,25,50,100",
        "current": {
          "selected": true,
          "text": "1",
          "value": "1"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Total Drops Detected",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_POSTGRESQL}"
      },
      "targets": [
        {
          "rawSql": "SELECT COUNT(*) AS \"Drops Detected\" FROM google_ads_placement_snapshot_changes WHERE drop_amount >= ${min_drop:raw} AND $__timeFilter(report_date::timestamptz) AND placement_type IN (${placement_type:sqlstring})",
          "format": "table",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 10 }
            ]
          }
        }
      }
    },
    {
      "id": 2,
      "title": "Total Impressions Lost",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_POSTGRESQL}"
      },
      "targets": [
        {
          "rawSql": "SELECT COALESCE(SUM(drop_amount), 0) AS \"Impressions Lost\" FROM google_ads_placement_snapshot_changes WHERE drop_amount >= ${min_drop:raw} AND $__timeFilter(report_date::timestamptz) AND placement_type IN (${placement_type:sqlstring})",
          "format": "table",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 50 },
              { "color": "red", "value": 200 }
            ]
          }
        }
      }
    },
    {
      "id": 3,
      "title": "Placements Affected",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_POSTGRESQL}"
      },
      "targets": [
        {
          "rawSql": "SELECT COUNT(DISTINCT placement_url) AS \"Placements Affected\" FROM google_ads_placement_snapshot_changes WHERE drop_amount >= ${min_drop:raw} AND $__timeFilter(report_date::timestamptz) AND placement_type IN (${placement_type:sqlstring})",
          "format": "table",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 3 },
              { "color": "red", "value": 10 }
            ]
          }
        }
      }
    },
    {
      "id": 4,
      "title": "Avg Drop %",
      "type": "gauge",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_POSTGRESQL}"
      },
      "targets": [
        {
          "rawSql": "SELECT ROUND(AVG(drop_percent)::numeric, 1) AS \"Avg Drop %\" FROM google_ads_placement_snapshot_changes WHERE drop_amount >= ${min_drop:raw} AND $__timeFilter(report_date::timestamptz) AND placement_type IN (${placement_type:sqlstring})",
          "format": "table",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "max": 100,
          "min": 0,
          "thresholds": {
            "steps": [
              { "color": "yellow", "value": null },
              { "color": "orange", "value": 30 },
              { "color": "red", "value": 60 }
            ]
          },
          "unit": "percent"
        }
      }
    },
    {
      "id": 5,
      "title": "Impression Drops by Placement",
      "description": "All placements where impressions decreased between snapshots — evidence of retroactive data manipulation",
      "type": "table",
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 5 },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_POSTGRESQL}"
      },
      "targets": [
        {
          "rawSql": "SELECT placement_name AS \"Placement\", placement_url AS \"URL\", placement_type AS \"Type\", report_date AS \"Report Date\", previous_snapshot_at AS \"First Seen\", snapshot_at AS \"Drop Detected\", previous_impressions AS \"Original\", current_impressions AS \"After Change\", drop_amount AS \"Impressions Lost\", drop_percent AS \"Drop %\" FROM google_ads_placement_snapshot_changes WHERE drop_amount >= ${min_drop:raw} AND $__timeFilter(report_date::timestamptz) AND placement_type IN (${placement_type:sqlstring}) ORDER BY drop_amount DESC LIMIT 200",
          "format": "table",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Impressions Lost" },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": { "type": "color-background", "mode": "gradient" }
              },
              {
                "id": "color",
                "value": {
                  "mode": "continuous-reds"
                }
              }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Drop %" },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": { "type": "color-background", "mode": "gradient" }
              },
              {
                "id": "color",
                "value": {
                  "mode": "continuous-reds"
                }
              },
              {
                "id": "unit",
                "value": "percent"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          { "displayName": "Impressions Lost", "desc": true }
        ]
      }
    },
    {
      "id": 6,
      "title": "Impression History by Placement (Across Snapshots)",
      "description": "Shows how each placement's reported impressions change over time as new CSV snapshots are loaded. Lines going down = data being retroactively removed.",
      "type": "timeseries",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 18 },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_POSTGRESQL}"
      },
      "targets": [
        {
          "rawSql": "SELECT snapshot_at AS \"time\", placement_name || ' (' || placement_url || ')' AS \"metric\", impressions AS \"value\" FROM google_ads_placements WHERE $__timeFilter(report_date::timestamptz) AND placement_type IN (${placement_type:sqlstring}) AND impressions > 0 ORDER BY snapshot_at",
          "format": "time_series",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "pointSize": 6,
            "showPoints": "always",
            "spanNulls": true
          },
          "color": { "mode": "palette-classic" }
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": ["first", "last", "diff"]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    }
  ]
}
